<!DOCTYPE html>
<html lang="en">
<head>
  <title><%= owner_page_title %> · Mailroom</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <%= tag.link rel: "icon", type: "image/svg+xml", href: mailroom_favicon %>
  <%= csrf_meta_tags %><%= csp_meta_tag %>
  <%= yield :head %>
  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>
<body class="<%= authenticated? ? 'owner-layout' : 'auth-layout' %>">
  <a href="#main-content" class="skip-link">Skip to content</a>
  <header class="sidebar">
    <%= link_to root_path, class: "brand" do %><%= mailroom_icon %><span>Mailroom</span><% end %>
    <% if authenticated? %>
      <nav class="primary-nav" aria-label="Main navigation">
        <% owner_navigation.each do |label, path, section| %>
          <%= link_to label, path, aria: { current: controller_name == section ? "page" : nil } %>
        <% end %>
      </nav>
      <section class="sidebar-domains" aria-labelledby="sidebar-domains-heading">
        <div class="sidebar-heading"><h2 id="sidebar-domains-heading">Your domains</h2><%= link_to "+", new_domain_path, aria: { label: "Add domain" }, class: "add-domain" %></div>
        <nav class="domain-unread" aria-label="Unread by domain">
          <% sidebar_domains.each do |domain| %>
            <% selected = controller_name == "messages" && params[:domain] == domain.name %>
            <%= link_to domain_inbox_path(domain), aria: { current: selected ? "page" : nil } do %>
              <span class="domain-name"><%= domain.name %></span><span class="count"><%= sidebar_unread_counts.fetch(domain.id, 0) %><span class="sr-only"> unread</span></span>
            <% end %>
          <% end %>
          <% if sidebar_domains.empty? %><%= link_to "Add your first domain", new_domain_path %><% end %>
        </nav>
      </section>
      <footer class="sidebar-footer">
        <span class="eyebrow">Signed in</span><span class="user-address"><%= Current.user.email_address %></span>
        <%= button_to "Sign out", session_path, method: :delete, class: "link-button" %>
      </footer>
    <% end %>
  </header>
  <main id="main-content" tabindex="-1">
    <div class="flash-stack">
      <% flash.each do |kind, message| %>
        <% next if kind == "alert" && content_for?(:inline_alert) %>
        <div class="flash <%= kind %>" role="<%= kind == 'alert' ? 'alert' : 'status' %>"><%= message %></div><% end %>
    </div>
    <%= yield %>
  </main>
</body>
</html>
