<!DOCTYPE html>
<html lang="en">
<head>
  <title><%= content_for(:title) || "Mailroom" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %><%= csp_meta_tag %>
  <%= yield :head %>
  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>
<body>
  <header class="site-header">
    <%= link_to "Mailroom", root_path, class: "brand" %>
    <% if authenticated? %>
      <nav aria-label="Main navigation">
        <%= link_to "Inbox", messages_path %><%= link_to "Domains", domains_path %>
        <%= link_to "Blocked senders", blocked_senders_path %>
        <%= link_to "Drafts", drafts_path %><%= link_to "API keys", api_keys_path %>
        <%= link_to "Audit", audit_events_path %><%= link_to "Settings", settings_path %>
        <%= button_to "Sign out", session_path, method: :delete, class: "link-button" %>
      </nav>
    <% end %>
  </header>
  <main>
    <% flash.each do |kind, message| %><div class="flash <%= kind %>" role="status"><%= message %></div><% end %>
    <%= yield %>
  </main>
</body>
</html>
