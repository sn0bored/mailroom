<div class="row"><h1>Domains</h1><%= link_to "Add domain", new_domain_path, class: "button" %></div>
<div class="table-scroll"><table><thead><tr><th>Name</th><th>Status</th><th>Last received</th><th>Send</th><th>Probe received</th></tr></thead><tbody>
<% @domains.each do |domain| %><tr>
<td><%= link_to domain.name, domain %></td><td><span class="pill"><%= domain.receiving? ? "receiving" : "waiting for mail" %></span></td>
<td><%= display_time(domain.last_received_at) %></td><td><%= domain.send_enabled? ? "On" : "Off" %></td><td><%= display_time(domain.probe_received_at) %></td>
</tr><% end %>
</tbody></table></div>
<% if @domains.empty? %><p>Add a domain to start receiving mail.</p><% end %>
