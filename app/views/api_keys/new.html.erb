<%= render "shared/page_header", title: "New API key", description: "Choose only the permissions this key needs." %>
<%= render "shared/errors", record: @api_key %>
<%= form_with model: @api_key, class: "panel form-panel", data: { turbo: false } do |form| %>
<%= form.label :name %><%= form.text_field :name, required: true, placeholder: "Inbox reader" %>
<fieldset><legend>Scopes</legend>
<% ApiKey::SCOPES.each do |scope| %><label class="check"><%= check_box_tag "api_key[scopes][]", scope, @api_key.scopes.include?(scope), id: "scope_#{scope.tr(':', '_')}" %><%= scope %></label><% end %>
</fieldset>
<%= form.label :allowed_from_domains, "Allowed from domains (comma separated)" %>
<%= form.text_field :allowed_from_domains, value: @api_key.allowed_from_domains.join(", "), placeholder: "example.org, example.net", aria: { describedby: "key-domains-help" } %>
<p id="key-domains-help" class="help">Leave domains blank to allow all owned domains.</p><%= form.submit "Create API key" %>
<% end %>
