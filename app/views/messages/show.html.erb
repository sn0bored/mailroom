<article class="message-detail">
  <%= link_to "Back to inbox", messages_path, class: "back-link" %>
  <%= render "shared/page_header", title: @message.subject.presence || "(No subject)", eyebrow: "Message" %>
  <dl class="message-envelope panel">
    <dt>From</dt><dd><%= @message.display_from %></dd>
    <dt>To</dt><dd><%= @message.to_address %></dd>
    <dt>Date</dt><dd><%= display_time(@message.received_at) %></dd>
    <dt>Domain</dt><dd><%= @message.domain&.name || "unrouted" %></dd>
    <dt>Routed via</dt><dd><%= @message.routed_via.presence || "Unavailable" %></dd>
    <dt>Spam score</dt><dd><%= @message.spam_score || "Unavailable" %></dd>
    <dt>Blocked</dt><dd><%= @message.blocked? ? "Yes" : "No" %></dd>
    <dt>Forward status</dt><dd><%= @message.forward_status || "Unavailable" %></dd>
    <dt>Matched addresses</dt><dd><%= Array(@message.matched_addresses).join(", ").presence || "None" %></dd>
  </dl>
  <div class="actions message-actions" role="group" aria-label="Message actions">
    <%= link_to "Reply", new_draft_path(message_id: @message.id), class: "button" %>
    <%= button_to(@message.read? ? "Mark unread" : "Mark read", message_path(@message), method: :patch, params: { read: @message.read? ? "0" : "1" }, class: "secondary") %>
    <%= button_to(@message.archived? ? "Unarchive" : "Archive", message_path(@message), method: :patch, params: { archived: @message.archived? ? "0" : "1" }, class: "secondary") %>
    <% if @message.from_address.present? %>
      <%= button_to "Block sender", blocked_senders_path, params: { blocked_sender: { pattern: @message.from_address } }, class: "danger" %>
      <%= button_to "Block sender's domain", blocked_senders_path, params: { blocked_sender: { pattern: @message.from_address.split("@").last } }, class: "danger" %>
    <% end %>
  </div>
  <section class="message-body" aria-label="Message body"><pre class="body"><%= @message.body_text.presence || "This message has no plain text body." %></pre></section>
  <section class="attachments" aria-labelledby="attachments-heading">
    <h2 id="attachments-heading">Attachments <span class="pill"><%= @message.attachments.size %></span></h2>
    <ul class="attachment-list"><% @message.attachments.each do |attachment| %>
      <li class="attachment-card panel"><div><strong><%= attachment.filename.to_s %></strong><span class="help"><%= number_to_human_size(attachment.byte_size) %></span></div>
        <%= link_to "Download", message_attachment_path(@message, attachment), class: "button secondary", aria: { label: "Download #{attachment.filename}" } %></li>
    <% end %></ul>
    <% unless @message.attachments.attached? %><p class="help">No attachments.</p><% end %>
  </section>
  <details class="raw-headers panel"><summary>Raw headers</summary><pre><%= raw_headers(@message) %></pre></details>
</article>
