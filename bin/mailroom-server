#!/bin/bash
# Start Mailroom in production on a machine that runs it under launchd or systemd.
# Reads ~/.mailroom/env (see .env.example) and starts two listeners on 127.0.0.1 only (config/puma.rb):
#   MAILROOM_PORT (default 3100)  internal: inbox, MCP and API. Reach it over a private path only
#                                 (Tailscale Serve, an SSH tunnel).
#   MAILROOM_PUBLIC_PORT          public: the Postmark webhook and /up. Point Tailscale Funnel or the
#                                 public reverse proxy here, and only here.
# Puma is started directly because `rails server -b/-p` would replace the second listener.
set -euo pipefail
cd "$(dirname "$0")/.."

export PATH="$HOME/.rbenv/shims:$HOME/.rbenv/bin:/opt/homebrew/bin:$PATH"
if [ -f "$HOME/.mailroom/env" ]; then
  set -a
  . "$HOME/.mailroom/env"
  set +a
fi

export RAILS_ENV="${RAILS_ENV:-production}"
export MAILROOM_DATA_DIR="${MAILROOM_DATA_DIR:-$HOME/.mailroom}"
export SOLID_QUEUE_IN_PUMA="${SOLID_QUEUE_IN_PUMA:-true}"
mkdir -p "$MAILROOM_DATA_DIR/logs" "$MAILROOM_DATA_DIR/storage" "$MAILROOM_DATA_DIR/backups"

exec bundle exec puma -C config/puma.rb -e "$RAILS_ENV"
