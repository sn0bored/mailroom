<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Nightly backup of every database and the raw mail store (bin/rails mailroom:backup). -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mailroom.backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REPO__/bin/mailroom-task</string>
    <string>mailroom:backup</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>20</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/.mailroom/logs/backup.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.mailroom/logs/backup.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>LANG</key>
    <string>en_US.UTF-8</string>
  </dict>
</dict>
</plist>
