# Mailroom configuration. Every value is read from the environment; nothing is hard-coded.
# Copy to ~/.mailroom/env on the machine that runs Mailroom (chmod 600) and source it before starting.

# Rails
SECRET_KEY_BASE=                # bin/rails secret
RAILS_ENV=production

# Where the databases, raw mail, attachments, logs and backups live (default in production: ~/.mailroom)
MAILROOM_DATA_DIR=

# Public hostname that receives the inbound webhook (for Tailscale Funnel: <machine>.<tailnet>.ts.net)
MAILROOM_PUBLIC_HOST=
# Optional: the tailnet-only hostname the web UI, MCP and API are served on (for Tailscale Serve, same name, port 8443)
MAILROOM_SERVE_HOST=
# Local port Puma listens on (127.0.0.1 only)
MAILROOM_PORT=3100

# Action Mailbox ingress password (basic auth user is "actionmailbox"); bin/rails secret works
RAILS_INBOUND_EMAIL_PASSWORD=

# Postmark SERVER token for the server that receives and sends (never the account token)
POSTMARK_SERVER_TOKEN=
# Message stream used for forward copies and probes (default: outbound)
MAILROOM_FORWARD_STREAM=outbound

# Forward copies: where copies of inbound mail go by default, and the verified address they are sent from
MAILROOM_DEFAULT_FORWARD_TO=
MAILROOM_FORWARD_SENDER=

# Stable identifier stamped on outbound mail so loops are detected (default: generated once and stored)
MAILROOM_INSTANCE_ID=

# Set to 1 only for local development without Tailscale in front
MAILROOM_TRUST_LOCAL=

# Run Solid Queue inside Puma (one process on a small machine)
SOLID_QUEUE_IN_PUMA=true
